<Window x:Class="AccountDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Deck" Width="900" Height="760" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid Margin="24,18,24,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastChecked}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip="Look for new sign-ins and update usage now" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Account Deck" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Switch between your accounts and keep an eye on their limits." Style="{StaticResource Muted}" />
                </StackPanel>
            </DockPanel>

            <TabControl Grid.Row="1">
                <TabItem Header="Accounts">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel Margin="4,12,4,4">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="{Binding IsDemo, Converter={StaticResource Show}}">
                                <TextBlock TextWrapping="Wrap" Text="Demo mode: these are sample accounts in a temporary folder. Nothing here touches your real Claude or Codex sign-ins." />
                            </Border>
                            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,24">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Add account" Command="{Binding Add}"
                                                        Visibility="{Binding CanAdd, Converter={StaticResource Show}}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Pill}" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Status}" FontSize="12" />
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                                       Visibility="{Binding HasHint, Converter={StaticResource Show}}" />
                                            <ItemsControl ItemsSource="{Binding Profiles}" Margin="0,10,0,0" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="240" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="252" />
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                               Visibility="{Binding HasDetail, Converter={StaticResource Show}}" />
                                                                    <Border Style="{StaticResource Pill}" Background="#2F8F6B" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                                            Visibility="{Binding IsActive, Converter={StaticResource Show}}">
                                                                        <TextBlock Text="In use now" FontSize="12" Foreground="White" />
                                                                    </Border>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                                                                    <ItemsControl ItemsSource="{Binding Bars}" Focusable="False">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Margin="0,2,0,6">
                                                                                    <DockPanel>
                                                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" FontSize="12" />
                                                                                        <TextBlock Text="{Binding Label}" FontSize="12" Style="{StaticResource Muted}" />
                                                                                    </DockPanel>
                                                                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,4,0,0"
                                                                                                 Foreground="{Binding Brush}" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" FontSize="12"
                                                                               Visibility="{Binding HasNote, Converter={StaticResource Show}}" />
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                    <Button Content="Switch" Command="{Binding Switch}" Style="{DynamicResource AccentButtonStyle}" MinWidth="76"
                                                                            Visibility="{Binding CanSwitch, Converter={StaticResource Show}}" />
                                                                    <Button Content="Rename" Command="{Binding Rename}" Margin="8,0,0,0" />
                                                                    <Button Content="Remove" Command="{Binding Remove}" Margin="8,0,0,0"
                                                                            Visibility="{Binding CanSwitch, Converter={StaticResource Show}}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Activity">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,12,4,4">
                            <TextBlock Text="Everything this app has done, newest first." Style="{StaticResource Muted}" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding Log}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Style="{StaticResource Muted}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="#D13438" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,12,4,4" MaxWidth="640" HorizontalAlignment="Left">
                            <TextBlock Text="General" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <CheckBox Content="Start Account Deck when I sign in to Windows" IsChecked="{Binding StartWithWindows}" />
                            <CheckBox Content="Keep running next to the clock when I close the window" IsChecked="{Binding CloseToTray}" Margin="0,4,0,0" />

                            <TextBlock Text="Usage" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Check usage every" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding RefreshChoices}" SelectedItem="{Binding RefreshMinutes}" Margin="8,0" MinWidth="70" />
                                <TextBlock Text="minutes" VerticalAlignment="Center" />
                            </StackPanel>
                            <CheckBox Content="Keep sign-ins fresh" IsChecked="{Binding KeepSignInsFresh}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="28,0,0,0"
                                       Text="Claude Code sign-ins expire after a few hours. With this on, Account Deck renews them so it can show usage for every saved account, including the ones you are not using right now." />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <CheckBox Content="Tell me when the Claude Code account in use reaches" IsChecked="{Binding NotifyOnHighUsage}" />
                                <ComboBox ItemsSource="{Binding ThresholdChoices}" SelectedItem="{Binding NotifyThreshold}" Margin="8,0" MinWidth="70" />
                                <TextBlock Text="% of a limit" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Automatic switching" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Switch Claude Code to another account when it reaches" IsChecked="{Binding AutoSwitchClaudeCode}" />
                                <ComboBox ItemsSource="{Binding ThresholdChoices}" SelectedItem="{Binding AutoSwitchThreshold}" Margin="8,0" MinWidth="70" />
                                <TextBlock Text="% of a limit" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="28,0,0,0"
                                       Text="Picks the saved account with the most room left. Claude Code sessions that are already open keep their account until you restart them. Claude Desktop is never switched automatically, because switching it closes the app." />

                            <TextBlock Text="Data" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                       Text="Saved accounts stay on this computer. Sign-ins are encrypted with your Windows account, and parked Claude Desktop accounts are kept as folders." />
                            <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Background="#73000000" Visibility="{Binding IsBusy, Converter={StaticResource Show}}">
            <Border Style="{StaticResource Card}" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,22" Width="380">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" FontSize="15" FontWeight="SemiBold" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
