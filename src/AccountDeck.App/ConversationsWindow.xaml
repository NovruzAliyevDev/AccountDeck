<Window x:Class="AccountDeck.App.ConversationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Deck - Conversations" Width="900" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Conversations" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap"
                       Text="Every conversation of every space. To continue one in another space, move it there: it leaves this space and shows up in the other one, in Claude Desktop's list too." />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search by title, first prompt, project folder or space" />
        </DockPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                 IsEnabled="{Binding IsIdle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="4,6">
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Targets}" Focusable="False" VerticalAlignment="Center" Margin="12,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource Pill}" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SpaceLabel}" FontSize="12" />
                                </Border>
                                <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Text}" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasDetail, Converter={StaticResource Show}}" />
                            <TextBlock Text="{Binding Project}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" MinWidth="90" Click="OnClose" />
            <TextBlock Text="Moving…" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource Show}}" />
        </DockPanel>
    </Grid>
</Window>
