<Window x:Class="AccountDeck.App.SpacesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account Deck - Spaces" Width="900" Height="680" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding StepText}" Style="{StaticResource Muted}" FontSize="12" />
            <TextBlock Text="{Binding Heading}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" />
            <TextBlock Text="{Binding Intro}" Style="{StaticResource Muted}" Margin="0,6,0,12" />
        </StackPanel>

        <!-- Step 1: spaces and their accounts -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStep1, Converter={StaticResource Show}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding SpaceRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Name" Style="{StaticResource Muted}" FontSize="12" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,12,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Claude Desktop account" Style="{StaticResource Muted}" FontSize="12" />
                                        <ComboBox ItemsSource="{Binding DesktopChoices}" DisplayMemberPath="Label" SelectedItem="{Binding Desktop}" Margin="0,4,12,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Claude Code account" Style="{StaticResource Muted}" FontSize="12" />
                                        <ComboBox ItemsSource="{Binding CodeChoices}" DisplayMemberPath="Label" SelectedItem="{Binding Code}" Margin="0,4,12,0" />
                                    </StackPanel>
                                    <RadioButton Grid.Column="3" Content="In use now" IsChecked="{Binding IsLive}" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                                 GroupName="live" IsEnabled="{Binding DataContext.IsSetup, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add a space" Command="{Binding AddSpaceCommand}" HorizontalAlignment="Left"
                        Visibility="{Binding IsSetup, Converter={StaticResource Show}}" />

                <StackPanel Visibility="{Binding IsSetup, Converter={StaticResource Show}}" Margin="0,24,0,0">
                    <TextBlock Text="Pre-sort my instructions (optional)" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Text="Hover over a name to see where it was found." />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,8"
                               Text="These names were found in your instructions and skills; the number is how many items mention each one. Tick the names that belong to one side, such as your company, its products and tools. On the next page, every item that mentions a ticked name starts on the space you pick below, and everything else starts as shared. You can still change each item there. Tick nothing to start with everything shared." />
                    <ItemsControl ItemsSource="{Binding Names}" Focusable="False" Visibility="{Binding HasNames, Converter={StaticResource Show}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" ToolTip="{Binding Where}" Margin="0,0,18,4" MinWidth="150" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" Text="No names were found in your instructions; everything starts as shared."
                               Visibility="{Binding NoNames, Converter={StaticResource Show}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Items that mention a ticked name start on" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ComboBox ItemsSource="{Binding SpaceOptions}" DisplayMemberPath="Label" SelectedItem="{Binding WorkSpace}" MinWidth="140" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Step 2: item by item -->
        <Grid Grid.Row="1" Visibility="{Binding IsStep2, Converter={StaticResource Show}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12,8" Cursor="Hand"
                                                        MouseLeftButtonUp="OnRowClicked">
                                                    <DockPanel>
                                                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                                                                  SelectedItem="{Binding Selected}" MinWidth="170" VerticalAlignment="Center" />
                                                        <StackPanel Margin="0,0,12,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Help}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Card}" Opacity="0.75">
                        <StackPanel>
                            <TextBlock Text="&#x1F512; Always separate" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="Conversations, file history, project memory and prompt history. These never mix." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Step 3: projects -->
        <Grid Grid.Row="1" Visibility="{Binding IsStep3, Converter={StaticResource Show}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Rules" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Rules}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Folders under" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" Width="300" Margin="8,0" ToolTip="For example D:\GameDev" />
                                    <TextBlock Text="go to" VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Label" SelectedItem="{Binding Selected}" MinWidth="140" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add a rule" Command="{Binding AddRuleCommand}" />
                        <Button Content="Apply rules to the list" Command="{Binding ApplyRulesCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Projects}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="12,8">
                                <StackPanel>
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                                                  SelectedItem="{Binding Selected}" MinWidth="150" VerticalAlignment="Center" />
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                                        </StackPanel>
                                    </DockPanel>
                                    <Expander Header="{Binding ExpandText}" IsExpanded="{Binding IsExpanded}" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding Conversations}" Focusable="False" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" DisplayMemberPath="Label"
                                                                  SelectedItem="{Binding Selected}" MinWidth="150" VerticalAlignment="Top" Margin="12,0,0,0"
                                                                  ToolTip="Pick a space for this conversation if it does not belong with the rest of the project" />
                                                        <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}" FontSize="12" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12"
                                                                       Visibility="{Binding HasDetail, Converter={StaticResource Show}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Step 4: summary -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsStep4, Converter={StaticResource Show}}">
            <Border Style="{StaticResource Card}">
                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" LineHeight="22" />
            </Border>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" IsCancel="True" MinWidth="88" />
                <Button Content="Back" Click="OnBack" MinWidth="88" Margin="8,0,0,0" IsEnabled="{Binding CanBack}" />
                <Button Content="{Binding NextText}" Click="OnNext" MinWidth="88" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
            <TextBlock />
        </DockPanel>
    </Grid>
</Window>
