<Window x:Class="AccountDeck.App.Dialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,20,24,20">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,10,0,0" />
        <TextBox x:Name="Input" Margin="0,12,0,0" Visibility="Collapsed" />
        <CheckBox x:Name="Check" Margin="0,12,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="Cancel" Content="Cancel" IsCancel="True" MinWidth="88" />
            <Button x:Name="Ok" IsDefault="True" MinWidth="88" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
