<Project Sdk="Microsoft.NET.Sdk">
  <!-- The macOS app: an Avalonia window + menu bar icon over the same AccountDeck.Core as the Windows app.
       Build the .app bundle with ./build-mac.sh at the repository root. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AccountDeck</AssemblyName>
    <RootNamespace>AccountDeck.Mac</RootNamespace>
    <Version>1.0.0</Version>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AccountDeck.Core\AccountDeck.Core.csproj" />
  </ItemGroup>
</Project>
