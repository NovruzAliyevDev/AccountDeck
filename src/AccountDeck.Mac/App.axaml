<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AccountDeck.Mac.App"
             Name="Account Deck"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBrush" Color="#F5F5F7" />
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="PillBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#6E6E73" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="#59000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBrush" Color="#1E1E1E" />
                    <SolidColorBrush x:Key="CardBrush" Color="#2A2A2C" />
                    <SolidColorBrush x:Key="CardStrokeBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="PillBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#A1A1A6" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B" />
                    <SolidColorBrush x:Key="ScrimBrush" Color="#80000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.error">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="{DynamicResource PillBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="9,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="28,0,0,0" />
        </Style>
    </Application.Styles>
</Application>
